<developer_name>Justin Kelly</developer_name>
<developer id="com.github.justinkelly">
  <name>Justin Kelly</name>
</developer>
  <launchable type="desktop-id">com.github.justinkelly.cosmic-ext-kickoff-launcher.desktop</launchable>
